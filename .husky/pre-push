#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Pre-push hook - runs on push to remote
# Runs tests and full validation

echo "🚀 Running pre-push checks..."

# Run all tests
echo "🧪 Running tests..."
bun test

# Run full build to ensure everything compiles
echo "🔨 Building project..."
bun run build

echo "✅ Pre-push checks passed! Ready to push."