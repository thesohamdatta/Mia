{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "core/**/index.ts",
    "core/test/**/*.ts",
    "core/skills/*/execute.ts",
    "scripts/*.ts",
    "tests/**/*.ts"
  ],
  "project": ["core/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn"
  }
}
