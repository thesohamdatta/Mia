{
  "$schema": "https://knip.dev/schema.json",
  "entry": ["core/cli/index.ts", "scripts/sync-docs.ts", "core/generator/gen-skill-docs.ts"],
  "project": ["core/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["node_modules", "dist", "build", "bin", "*.exe", ".git", ".husky", ".claude"],
  "ignoreDependencies": [
    "typescript",
    "@biomejs/biome",
    "husky",
    "markdownlint-cli2",
    "knip",
    "zod"
  ],
  "rules": {
    "dependencies": "error",
    "devDependencies": "error",
    "exports": "off",
    "files": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "types": "off",
    "unlisted": "warn",
    "unresolved": "error"
  }
}
