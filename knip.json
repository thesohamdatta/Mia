{
  "$schema": "https://knip.dev/schema.json",
  "entry": ["core/**/index.ts", "core/test/**/*.ts", "core/skills/*/execute.ts", "scripts/*.ts"],
  "project": ["core/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["node_modules", "dist", "build", "bin", "*.exe", ".git", ".husky", ".claude"],
  "ignoreDependencies": [
    "typescript",
    "@biomejs/biome",
    "vitest",
    "husky",
    "markdownlint-cli2",
    "lychee",
    "typos-cli",
    "knip"
  ],
  "rules": {
    "dependencies": "warn",
    "devDependencies": "warn",
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "unlisted": "error",
    "unresolved": "error"
  }
}
