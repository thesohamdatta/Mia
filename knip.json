{
  "$schema": "https://knip.dev/schema.json",
  "entry": [
    "core/context.ts",
    "core/config/index.ts",
    "core/hosts/index.ts",
    "core/skills/index.ts",
    "core/skills/types.ts",
    "core/skills/preamble.ts",
    "core/skills/executor.ts",
    "core/skills/checkpoint/execute.ts",
    "core/skills/grill/execute.ts",
    "core/skills/health/execute.ts",
    "core/skills/learn/execute.ts",
    "core/skills/memory/execute.ts",
    "core/skills/plan/execute.ts",
    "core/skills/retro/execute.ts",
    "core/skills/review/execute.ts",
    "core/skills/ship/execute.ts",
    "core/skills/spec/execute.ts",
    "core/skills/vc/execute.ts",
    "core/state/index.ts",
    "core/state/jsonl-store.ts",
    "core/state/unified-store.ts",
    "core/test/index.ts",
    "core/test/types.ts"
  ],
  "project": ["core/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "rules": {
    "dependencies": "error",
    "devDependencies": "error",
    "exports": "error",
    "files": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "types": "error",
    "unlisted": "warn",
    "unresolved": "error"
  }
}
