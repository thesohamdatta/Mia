{
  "$schema": "https://knip.dev/schema.json",
  "entry": ["core/**/index.ts", "core/test/**/*.ts", "core/skills/*/execute.ts", "scripts/*.ts"],
  "project": ["core/**/*.ts", "scripts/**/*.ts"],
  "rules": {
    "dependencies": "warn",
    "devDependencies": "warn",
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "unlisted": "error",
    "unresolved": "error"
  }
}
