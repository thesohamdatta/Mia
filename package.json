{
  "name": "mia",
  "version": "0.2.1",
  "description": "Machine Intelligence Architecture - Personal AI Engineering OS",
  "main": "core/cli/index.ts",
  "scripts": {
    "dev:cli": "bun run core/cli/index.ts",
    "dev:daemon": "bun run core/daemon/server.ts",
    "build:cli": "bun build --compile core/cli/index.ts --outfile bin/mia",
    "build:daemon": "bun build --compile core/daemon/server.ts --outfile bin/miad",
    "build": "bun run build:cli && bun run build:daemon",
    "start": "bun run bin/mia",
    "daemon": "bun run bin/miad",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:skill-docs": "bun run core/generator/gen-skill-docs.ts",
    "lint": "biome check --write --unsafe .",
    "lint:check": "biome check .",
    "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \"scripts/**/*.md\" \"tests/**/*.md\" --config .markdownlint-cli2.jsonc",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" --fix --config .markdownlint-cli2.jsonc",
    "validate:frontmatter": "bun run scripts/validate-frontmatter.ts",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "validate": "bun run lint && bun run typecheck && bun run knip",
    "prepare": "husky install",
    "postinstall": "bun run build"
  },
  "keywords": ["ai", "agent", "workflow", "automation", "mia"],
  "author": "Soham Datta",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@biomejs/biome": "^1.7.0",
    "knip": "^5.10.0",
    "vitest": "^1.4.0",
    "husky": "^9.0.0",
    "markdownlint-cli2": "^0.12.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.22.0",
    "@types/bun": "^1.1.0"
  }
}
