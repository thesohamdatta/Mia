{
  "name": "mia",
  "version": "0.3.0",
  "description": "Machine Intelligence Architecture - Personal AI Engineering OS",
  "main": "core/cli/index.ts",
  "scripts": {
    "dev": "bun run core/cli/index.ts",
    "build": "bun build --compile core/cli/index.ts --outfile bin/mia",
    "start": "bun run bin/mia",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "gen:skill-docs": "bun run core/generator/gen-skill-docs.ts",
    "lint": "bun x biome check --write --unsafe .",
    "lint:check": "bun x biome check .",
    "lint:md": "bun x markdownlint-cli2 \"*.md\" \"docs/**/*.md\" \"scripts/**/*.md\" --config .markdownlint-cli2.jsonc",
    "lint:md:fix": "bun x markdownlint-cli2 \"**/*.md\" --fix --config .markdownlint-cli2.jsonc",
    "validate:frontmatter": "bun run scripts/sync-docs.ts",
    "typecheck": "bun x tsc --noEmit",
    "knip": "bun x knip",
    "validate": "bun run lint && bun run typecheck && bun run knip",
    "prepare": "husky install",
    "postinstall": "bun run build"
  },
  "keywords": ["ai", "agent", "workflow", "automation", "mia"],
  "author": "Soham Datta",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "@biomejs/biome": "^1.7.0",
    "knip": "^5.10.0",
    "vitest": "^1.4.0",
    "husky": "^9.0.0",
    "markdownlint-cli2": "^0.12.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.22.0",
    "@types/bun": "^1.1.0"
  }
}
